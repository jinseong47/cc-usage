#!/usr/bin/env bash
set -euo pipefail

CACHE_DIR="${CC_USAGE_CACHE_DIR:-${HOME}/.cache/cc-usage}"
COUNT_FILE="${CACHE_DIR}/claude_sessions.count"
PID_FILE="${CACHE_DIR}/cc-usage-daemon.pid"
LOCK_DIR="${CACHE_DIR}/.session-lock"
LOG_FILE="${CACHE_DIR}/cc-usage-daemon.log"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

CLAUDE_CMD="${CC_CLAUDE_CMD:-claude}"
PROJECT_NAME="${CC_USAGE_PROJECT:-codex-local}"
USAGE_SESSION="${CC_USAGE_TMUX_SESSION:-cc-usage-probe}"
USAGE_INTERVAL="${CC_USAGE_SYNC_INTERVAL:-20}"
DAEMON_ENABLED="${CC_USAGE_ENABLE_DAEMON:-1}"
CLEANED="0"
DB_URL="${DATABASE_URL:-${CC_USAGE_DATABASE_URL:-}}"

mkdir -p "${CACHE_DIR}"

acquire_lock() {
  local tries=0
  until mkdir "${LOCK_DIR}" 2>/dev/null; do
    local owner_pid=""
    if [ -f "${LOCK_DIR}/pid" ]; then
      owner_pid="$(tr -dc '0-9' < "${LOCK_DIR}/pid")"
      if [ -n "${owner_pid}" ] && ! pid_running "${owner_pid}"; then
        rm -f "${LOCK_DIR}/pid"
        rmdir "${LOCK_DIR}" 2>/dev/null || true
        continue
      fi
    else
      # Recover stale lock directory left without owner metadata.
      rmdir "${LOCK_DIR}" 2>/dev/null || true
    fi
    sleep 0.05
    tries=$((tries + 1))
    if [ "${tries}" -ge 400 ]; then
      echo "[cc-claude] lock timeout: ${LOCK_DIR}" >&2
      return 1
    fi
  done
  printf "%s\n" "$$" > "${LOCK_DIR}/pid"
}

release_lock() {
  rm -f "${LOCK_DIR}/pid" 2>/dev/null || true
  rmdir "${LOCK_DIR}" 2>/dev/null || true
}

read_count() {
  if [ -f "${COUNT_FILE}" ]; then
    tr -dc '0-9' < "${COUNT_FILE}"
  else
    echo "0"
  fi
}

write_count() {
  printf "%s\n" "$1" > "${COUNT_FILE}"
}

pid_running() {
  local pid="$1"
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

read_pid() {
  if [ -f "${PID_FILE}" ]; then
    tr -dc '0-9' < "${PID_FILE}"
  else
    echo ""
  fi
}

start_daemon_if_needed() {
  [ "${DAEMON_ENABLED}" = "1" ] || return 0

  local pid
  pid="$(read_pid)"
  if pid_running "${pid}"; then
    return 0
  fi

  if [ -z "${DB_URL}" ]; then
    echo "[cc-claude] DATABASE_URL/CC_USAGE_DATABASE_URL not set; skipping daemon start" >&2
    return 0
  fi

  nohup env DATABASE_URL="${DB_URL}" python3 "${ROOT_DIR}/scripts/cc_usage/main.py" daemon \
    --project "${PROJECT_NAME}" \
    --usage-tmux-session "${USAGE_SESSION}" \
    --usage-sync-interval "${USAGE_INTERVAL}" >>"${LOG_FILE}" 2>&1 &
  printf "%s\n" "$!" > "${PID_FILE}"
}

stop_daemon_if_needed() {
  [ "${DAEMON_ENABLED}" = "1" ] || return 0

  local pid
  pid="$(read_pid)"
  if pid_running "${pid}"; then
    kill "${pid}" 2>/dev/null || true
  fi
  rm -f "${PID_FILE}"
}

cleanup() {
  if [ "${CLEANED}" = "1" ]; then
    return
  fi
  CLEANED="1"

  acquire_lock || exit 1
  local count
  count="$(read_count)"
  if [ -z "${count}" ]; then
    count=0
  fi
  if [ "${count}" -gt 0 ]; then
    count=$((count - 1))
  fi
  write_count "${count}"
  if [ "${count}" -eq 0 ]; then
    stop_daemon_if_needed
  fi
  release_lock
}

trap cleanup EXIT INT TERM

acquire_lock
count="$(read_count)"
if [ -z "${count}" ]; then
  count=0
fi
count=$((count + 1))
write_count "${count}"
if [ "${count}" -eq 1 ]; then
  start_daemon_if_needed
fi
release_lock

"${CLAUDE_CMD}" "$@"
